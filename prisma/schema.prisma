datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum TeamStatus {
  OPEN
  IN_TEAM
  TEAM_FULL
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  college      String    @default("GL Bajaj Group of Institutions, Mathura")
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentProfile StudentProfile?
  mentorProfile  MentorProfile?
}

model StudentProfile {
  userId      String     @id
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  year        String
  branch      String
  gender      String? // Collected during onboarding
  rollNo      String? // College roll number
  section     String? // Class section (A-I)
  category    String? // General, OBC, SC, ST
  contact     String? // Mobile number
  isDemo      Boolean    @default(false) // Sandbox/troubleshooting account
  skills      String[] // Technical skills
  languages   String[] // Languages spoken (e.g. Hindi, English)
  softSkills  String[] // Soft skills (e.g. PPT making, Presenting)
  resumeUrl   String?
  githubUrl   String?
  linkedinUrl String?
  avatarUrl   String?
  teamStatus  TeamStatus @default(OPEN)
  teamId      String?
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  roleInTeam  String     @default("Member")

  trackInterest Track[]       @relation("StudentTrackInterest")
  joinRequests  JoinRequest[]
  teamInvites   TeamInvite[]

  // The teammate directory filters on teamStatus and excludes demo rows; the
  // roster and dashboard queries look members up by teamId.
  @@index([teamId])
  @@index([teamStatus, isDemo])
}

model MentorProfile {
  userId          String          @id
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  designation     String
  organization    String
  isDemo          Boolean         @default(false) // Sandbox/troubleshooting account
  expertise       String[] // Expertise tags
  verified        Boolean         @default(false)
  bio             String?
  linkedinUrl     String?
  avatarUrl       String?
  contact         String? // Mobile / Phone number
  registrationKey String? // Key used during sign up
  teams           Team[]
  mentorRequests  MentorRequest[]

  // /api/mentors serves only verified mentors.
  @@index([verified])
}

model Track {
  id                   String @id @default(uuid())
  name                 String
  problemStatementCode String @unique
  description          String
  category             String

  teams          Team[]
  secondaryTeams Team[]           @relation("SecondaryTrack")
  students       StudentProfile[] @relation("StudentTrackInterest")
}

model Team {
  id                      String              @id @default(uuid())
  teamCode                String              @unique
  codeReservation         TeamCodeReservation @relation(fields: [teamCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  name                    String
  trackId                 String
  track                   Track               @relation(fields: [trackId], references: [id])
  secondaryTrackId        String?
  secondaryTrack          Track?              @relation("SecondaryTrack", fields: [secondaryTrackId], references: [id], onDelete: SetNull)
  leaderId                String
  status                  String              @default("forming") // forming, complete, locked
  mentorId                String?
  mentor                  MentorProfile?      @relation(fields: [mentorId], references: [userId], onDelete: SetNull)
  memberCount             Int                 @default(1)
  skillsCovered           String[]
  skillsNeeded            String[]
  whatsapp                String?
  logoUrl                 String?
  primaryPsType           String?             @default("Software") // "Software" | "Hardware"
  secondaryPsType         String?             @default("Software") // "Software" | "Hardware"
  customMentorName        String?
  customMentorDesignation String?
  customMentorMobile      String?
  customMentorEmail       String?

  members            StudentProfile[]
  invites            TeamInvite[]
  joinRequests       JoinRequest[]
  mentorRequests     MentorRequest[]
  messages           Message[]
  recruitmentNotices RecruitmentNotice[]

  @@index([trackId])
  @@index([secondaryTrackId])
  @@index([leaderId])
  @@index([mentorId])
  @@index([status, memberCount])
}

// Immutable allocation ledger for public SIH identifiers. A Team row may be
// deleted, but its reservation remains forever so the code can never be reused.
model TeamCodeReservation {
  code        String   @id
  allocatedAt DateTime @default(now())
  team        Team?
}

model RecruitmentNotice {
  id           String   @id @default(uuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role         String
  gender       String // "MALE" | "FEMALE" | "OPEN"
  abilities    String[]
  requirements String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([teamId])
}

model TeamInvite {
  id        String         @id @default(uuid())
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  status    String         @default("pending") // pending, accepted, declined
  createdAt DateTime       @default(now())

  // Both sides of the invite flow filter by status: the invitee lists their
  // own pending invites, the leader lists the team's.
  @@index([studentId, status])
  @@index([teamId, status])
}

model JoinRequest {
  id        String         @id @default(uuid())
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  status    String         @default("pending") // pending, accepted, declined
  message   String?
  createdAt DateTime       @default(now())

  @@index([studentId, status])
  @@index([teamId, status])
}

model MentorRequest {
  id        String        @id @default(uuid())
  teamId    String
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    MentorProfile @relation(fields: [mentorId], references: [userId], onDelete: Cascade)
  status    String        @default("pending") // pending, accepted, declined
  message   String?
  createdAt DateTime      @default(now())

  @@index([mentorId, status])
  @@index([teamId, status])
}

// Admin allowlist. Only emails here (plus the immutable super admin defined in
// src/lib/admin.ts) can reach /admin. Stored lowercased.
model AdminEmail {
  email     String   @id
  addedBy   String?
  createdAt DateTime @default(now())
}

// Revoked accounts. Blocks login regardless of valid credentials. Stored lowercased.
model BannedEmail {
  email     String   @id
  reason    String?
  bannedBy  String?
  createdAt DateTime @default(now())
}

model MentorRegistrationKey {
  key          String   @id
  isUsed       Boolean  @default(false)
  usedByUserId String?  @unique
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // invite_received, request_accepted, etc.
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model Message {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  senderId  String
  content   String
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}
