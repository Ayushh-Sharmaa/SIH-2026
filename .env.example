# ==========================================
# SIH@GLBGOI ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER put real secrets in this example file -
# it is committed to the repository and readable by anyone.
#
# Every variable below must also be set in Vercel:
# Project Settings -> Environment Variables (Production + Preview + Development)

# 1. Clerk Authentication Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# 2. Application JWT Secret
# Signs the session cookie. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, src/lib/auth.ts falls back to a value visible in this repo,
# which would let anyone forge an admin session.
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=https://your-deployment-url.vercel.app

# 3. Supabase Postgres
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> ORMs/Prisma
# DATABASE_URL uses the transaction pooler (6543) for app queries.
# DIRECT_URL uses the session pooler (5432) for migrations.
# Passwords with special characters must be URL-encoded (? -> %3F, + -> %2B).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# 4. Sandbox troubleshooting account (BanTan@BanTan0607)
# Passwordless access for exploring the student/mentor dashboards.
# Set to "false" to disable it entirely (recommended before public judging).
ENABLE_SANDBOX_ACCOUNT=true

# 5. Mentor master registration key (OPTIONAL — leave unset in most deployments)
#
# Grants MENTOR on signup/onboarding without a single-use database key. The
# previous value was hardcoded in the source and is in the git history, so it is
# public and is now rejected even if you set it here. There is deliberately no
# fallback: unset this and mentor registration uses MentorRegistrationKey rows
# only, which is the safer default.
#
# Must be >= 24 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# GLB_MENTOR_MASTER_KEY=

# 6. Rate limiting (all optional — these are the built-in defaults)
#
# Auth routes: per-IP burst plus per-IP and per-account consecutive-failure
# backoff. Backoff is exponential (base * multiplier^excess, capped), not a hard
# lockout, so a user who mistypes a password is delayed rather than locked out.
# AUTH_MAX_IP_FAILURES=5
# AUTH_MAX_ACCOUNT_FAILURES=3
# AUTH_BASE_BACKOFF_MS=30000
# AUTH_BACKOFF_MULTIPLIER=2
# AUTH_MAX_BACKOFF_MS=3600000
# AUTH_IP_LIMIT=20
# AUTH_IP_WINDOW_MS=60000
#
# Public (unauthenticated) endpoints, keyed by IP.
# PUBLIC_LIMIT=60
# PUBLIC_WINDOW_MS=60000
#
# Authenticated actions, keyed by user id.
# AUTH_USER_LIMIT=200
# AUTH_USER_WINDOW_MS=60000
